# Tijori gateway — copy to .env and adjust.

# --- LLM backend (OpenAI-compatible). Default: local Ollama. ---
TIJORI_LLM_PROVIDER=openai_compatible
TIJORI_LLM_BASE_URL=http://127.0.0.1:11434/v1
TIJORI_LLM_API_KEY=ollama
TIJORI_LLM_MODEL=qwen2.5:3b
TIJORI_LLM_TIMEOUT_S=120
TIJORI_LLM_TEMPERATURE=0.2
TIJORI_LLM_MAX_TOKENS=512

# Low-memory Ollama tuning (16 GB laptop, CPU only)
TIJORI_OLLAMA_NUM_CTX=4096

# --- Gateway ---
TIJORI_DB_PATH=data/audit.db
TIJORI_API_URL=http://127.0.0.1:8000
TIJORI_MAX_INPUT_CHARS=100000
TIJORI_LOG_LEVEL=INFO

# --- Genuinely external provider (optional, for judging) ---
# TIJORI_LLM_BASE_URL=https://openrouter.ai/api/v1
# TIJORI_LLM_API_KEY=sk-or-...
# TIJORI_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
